<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_role"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#ECEFF1"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_icon_bg"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8EAF6">

                <ImageView
                    android:id="@+id/iv_role_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="#3949AB"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_role_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Administrator"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tv_role_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ROLE_SYSTEM_ADMIN"
                    android:textColor="@color/primary_purple"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_user_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_rounded"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="1 User"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_role_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Full system configuration, security monitoring, user management, and token lifecycle control."
            android:textColor="@color/gray_700"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_permissions_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔒 Full Access • 8 Permissions Active"
                android:textColor="#3949AB"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage →"
                android:textColor="@color/primary_purple"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
