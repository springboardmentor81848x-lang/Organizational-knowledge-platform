<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#ECEFF1"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFEBEE">

                <ImageView
                    android:id="@+id/iv_gap_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#E53935"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_skill_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Java &amp; Spring Boot"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tv_departments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Backend Engineering • Cloud &amp; DevOps"
                    android:textColor="@color/gray_700"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_gap_severity_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_rounded"
                android:backgroundTint="#FFEBEE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="HIGH RISK"
                android:textColor="#E53935"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#F8F9FA"
            android:padding="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workforce Impact"
                    android:textColor="@color/gray_700"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_impact_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="3 Employees (60%)"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Competency Target"
                    android:textColor="@color/gray_700"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_benchmark_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Required: EXPERT"
                    android:textColor="@color/primary_purple"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_gap_severity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:progress="70"
            app:indicatorColor="#E53935"
            app:trackColor="#ECEFF1"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
