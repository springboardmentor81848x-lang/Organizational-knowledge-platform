# Backend API Base URL
# Local development: http://localhost:8080/api (or leave empty to proxy via Vite)
# Production on Render: https://your-backend-name.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: Google OAuth 2.0 Client ID (Leave empty to use email/password login)
VITE_GOOGLE_CLIENT_ID=
