# Base URL for the Spring Boot API. Leave empty in development to use the Vite
# proxy in vite.config.ts; set it explicitly for a deployed build.
VITE_API_BASE_URL=

# Google OAuth (legacy direct verification — optional if using Firebase instead)
VITE_GOOGLE_CLIENT_ID=

# Firebase Authentication — set all three to enable social sign-in buttons
# (Google, GitHub, Microsoft). Get these from Firebase Console > Project Settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
