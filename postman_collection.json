      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Employee (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    var token = data.accessToken || data.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('jwt_token', token);",
                  "        console.log('JWT Token successfully set in collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@orgskills.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as Alice Johnson (Employee) and automatically sets the {{jwt_token}} variable for subsequent requests."
          }
        },
