<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Skills Analysis"
            app:titleTextColor="@color/text_dark" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Heatmap -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Team Gap Heatmap" android:textStyle="bold" android:textColor="@color/text_dark" android:textSize="18sp" android:fontFamily="sans-serif-black" />

            <com.google.android.material.card.MaterialCardView style="@style/RoundedCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <!-- Horizontal scroll for heatmap -->
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TableLayout android:id="@+id/table_heatmap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:stretchColumns="*" />
                    </HorizontalScrollView>

                    <!-- Legend -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center">
                        <include layout="@layout/view_legend_item" android:id="@+id/legend_low" />
                        <include layout="@layout/view_legend_item" android:id="@+id/legend_med" android:layout_marginStart="16dp" />
                        <include layout="@layout/view_legend_item" android:id="@+id/legend_high" android:layout_marginStart="16dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skill Coverage -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Department Skill Coverage" android:textStyle="bold" android:textColor="@color/text_dark" android:textSize="18sp" android:fontFamily="sans-serif-black" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_skill_coverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- High Risk Gaps -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="High-Risk Alerts" android:textStyle="bold" android:textColor="@color/text_dark" android:textSize="18sp" android:fontFamily="sans-serif-black" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_high_risk_gaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
