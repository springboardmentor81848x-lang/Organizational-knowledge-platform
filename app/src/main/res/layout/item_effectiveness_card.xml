<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RoundedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_skill_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☕ Java &amp; Spring Boot"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tv_growth_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0 ➔ 4.5 (+125%)"
                android:textColor="@color/primary_emerald"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_growth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:progress="90"
            app:indicatorColor="@color/primary_emerald"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tv_impact_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mentee: Aarav Sharma • Verified competency progression"
            android:textColor="@color/gray_700"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
