/target/
/Backend/target/
/backend/target/
**/target/
/.idea/
*.iml
/.vscode/
node_modules/
/Frontend/node_modules/
/frontend/node_modules/
**/node_modules/
*.zip
.env
.env.*
**/.env
**/.env.*
# ...but the templates are documentation and must be committed. This has to come after the
# rules above, and has to match *.example rather than just .env.example, or a file such as
# .env.prod.example is quietly excluded and the deployment instructions ship without it.
!*.example
!**/*.example

# The Firebase service-account key. A private credential — it must never be committed.
# The path is configurable via FIREBASE_SERVICE_ACCOUNT_PATH; the default filename is matched
# here, and the glob covers a key downloaded under any other name.
*firebase-adminsdk*.json
