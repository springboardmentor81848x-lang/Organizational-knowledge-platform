# ==============================================================================
# KnowledgeIQ Platform Root .gitignore
# Filters out build outputs, dependencies, local env secrets, logs, and OS files.
# ==============================================================================

# Environment & Secret Files (CRITICAL: Do NOT commit production secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!backend/.env.example
!knowledgeiq-react/.env.example

# Node Dependencies & Package Locks
node_modules/
backend/node_modules/
knowledgeiq-react/node_modules/

# Build Outputs & Compilation Targets
target/
backend/target/
dist/
knowledgeiq-react/dist/
build/
out/
bin/
*.class
*.jar
*.war
*.ear

# Logs, Diagnostics & Temp Data
*.log
logs/
tmp/
temp/
scratch/
.system_generated/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configurations
.vscode/
.idea/
*.iws
*.iml
*.ipr
.settings/
.project
.classpath
.factorypath

# OS Metadata & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary Test Files & Artifacts
test_aws_cert.pdf
*.pdf
coverage/
*.zip
