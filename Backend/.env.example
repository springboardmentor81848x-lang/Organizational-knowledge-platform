# Environment for THIS FILE'S TWO CONSUMERS, which are not the same thing:
#
#   - Docker Compose reads .env automatically. DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD and
#     REDIS_PORT shape the containers.
#   - The Spring Boot application does NOT. There is no dotenv library on the classpath, so
#     every value below reaches the application only if it is exported into the shell first
#     (`set -a && . ./.env && set +a`), or set some other way.
#
# That asymmetry is worth knowing about, because getting it wrong fails quietly rather than
# loudly: setting DB_PORT=5433 here moves the container while the application keeps its
# `localhost:5432` default, and if anything else is listening there it will connect to that
# instead and start normally against the wrong database.

# Backend environment. Copy to .env and adjust; every value below is also the default that
# src/main/resources/application.yml falls back to, so an unset variable is not an error.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/org_skills
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Read by docker-compose.yml when creating the container.
DB_NAME=org_skills
DB_PORT=5432
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Hibernate schema handling. `update` lets Hibernate reshape the schema to match the entities,
# which is what the H2 setup did. Move to `validate` once the schema is owned by migrations.
DDL_AUTO=update
SHOW_SQL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# A cache timeout falls through to the database, so this is kept short on purpose: while
# Redis is down every cached read would otherwise pay it twice.
REDIS_TIMEOUT=250ms
REDIS_CONNECT_TIMEOUT=250ms
REDIS_MAXMEMORY=256mb

# `redis` uses the cache manager in RedisCacheConfig; `simple` falls back to an in-process
# cache, which is a way to run locally without Redis. `none` disables caching entirely.
CACHE_TYPE=redis
CACHE_TTL_CATALOG_MINUTES=60
CACHE_TTL_ANALYTICS_MINUTES=10

# --- Application ---
PORT=8081
JWT_SECRET=change-me-to-a-secure-32-char-minimum-secret
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=org-knowledge-gap-firebase-adminsdk-fbsvc-fd30b420b6.json
OPENAI_API_KEY=
LLM_MOCK_ENABLED=true
