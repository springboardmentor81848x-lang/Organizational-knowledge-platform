# Keeps the build context small and, more importantly, keeps credentials out of it. Anything
# listed here is never sent to the Docker daemon, so it cannot end up in an image layer even by
# accident — and an image layer is forever, whatever a later step deletes.

target/
*.jar

# The Firebase service-account key. It reaches the container as a mounted secret at runtime,
# never as part of the image. See docker-compose.prod.yml.
*firebase-adminsdk*.json

.env
.env.*
!.env.example

.git
.gitignore
.idea/
*.iml
.vscode/

Dockerfile
.dockerignore
README.md
postman_collection.json
run-backend.ps1
