# Stop Lombok at this directory rather than searching upwards for another config.
config.stopBubbling = true

# Carry @Qualifier from the field onto the constructor parameter Lombok generates.
#
# Without this, @RequiredArgsConstructor silently drops it, and the qualifier has no effect:
# Spring sees an unqualified parameter and resolves it by type alone. That is invisible while
# only one bean of the type exists, and becomes a startup failure the moment a second appears -
# which is exactly what happened when spring-boot-starter-actuator was added and brought a second
# RequestMappingHandlerMapping with it. The annotation was already on the field and already
# correct; it just was not reaching the constructor.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
