# ==============================================================================
# KnowledgeIQ Platform Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# ==============================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/knowledgeiq
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client Settings
VITE_API_BASE_URL=http://localhost:8086/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
