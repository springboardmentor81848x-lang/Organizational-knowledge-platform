# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # edit every value marked REQUIRED
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Unlike Backend/.env.example, this file IS read by the application: Compose passes these
# through as container environment variables, so there is no "export it into the shell first"
# asymmetry to trip over here.
#
# .env.prod is gitignored. Keep it that way — it holds every credential the platform has.

# ── Public address ──────────────────────────────────────────────────────────────
# REQUIRED. The origin people will actually type, scheme included, no trailing slash.
# Becomes CORS_ALLOWED_ORIGINS on the API.
PUBLIC_ORIGIN=https://skills.example.com

# The host port nginx publishes on. Leave at 80 behind a TLS terminator, or set something like
# 8080 if a reverse proxy on the host already owns port 80.
WEB_PORT=80

# ── Database ────────────────────────────────────────────────────────────────────
# REQUIRED. Postgres is not published outside the compose network, but this password is still
# the only thing between a container on that network and every row in the system.
DB_USERNAME=orgskills
DB_PASSWORD=
DB_NAME=org_skills

# Hibernate owns the schema (`update`). Move to `validate` once a migration tool does instead,
# so a stale entity cannot silently reshape a table holding real rows.
DDL_AUTO=update

# ── Cache ───────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# ── Authentication ──────────────────────────────────────────────────────────────
# REQUIRED. At least 32 characters, and not the default — every session token in the system is
# signed with this. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── Firebase social sign-in ─────────────────────────────────────────────────────
# REQUIRED (you enabled this). Absolute path ON THE HOST to the service-account JSON downloaded
# from the Firebase console. It is mounted read-only into the container; it is never copied into
# an image, and .dockerignore blocks it from the build context so it cannot be added by mistake.
FIREBASE_KEY_FILE=/etc/orgskills/firebase-service-account.json

# The three public Firebase web values. These are BUILD-TIME for the frontend: Vite inlines
# them into the bundle, so changing one means rebuilding the web image, not restarting it.
# They are not secrets — a Firebase web API key is a project identifier, and access is governed
# by Firebase security rules and by the backend verifying every ID token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project

# Optional: only needed for the legacy direct Google verification path, not for Firebase.
GOOGLE_CLIENT_ID=

# ── Live AI recommendations ─────────────────────────────────────────────────────
# REQUIRED (you enabled this). With LLM_MOCK_ENABLED=false the key must be present, or the
# service falls back to rule-based recommendations and logs a warning.
LLM_MOCK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3.6-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ── Outbound email ──────────────────────────────────────────────────────────────
# REQUIRED (you enabled this). With MAIL_HOST set, sign-up verification codes are delivered for
# real; leave it unset and they are written to the server log instead.
# Note: the mail health indicator is disabled in application.yml on purpose, so a flaky SMTP
# server cannot drag the health endpoint DOWN and get a working container pulled from service.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
